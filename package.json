{
	"name": "realm",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"debug": "NODE_OPTIONS=\"--inspect\" vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest",
		"prepare": "pnpm paraglide || echo '' && svelte-kit sync || echo ''",
		"paraglide": "paraglide-js compile --silent --project ./project.inlang --outdir ./src/lib/paraglide",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint --fix --fix-suggestions && eslint --fix .",
		"lint:ci": "oxfmt --check && oxlint && eslint ."
	},
	"dependencies": {
		"@inlang/paraglide-js": "2.24.1",
		"bits-ui": "2.19.0",
		"ky": "2.0.2",
		"luxon": "3.7.2",
		"mode-watcher": "1.1.0",
		"tiny-invariant": "1.3.3"
	},
	"devDependencies": {
		"@inlang/cli": "3.3.3",
		"@internationalized/date": "3.12.3",
		"@lucide/svelte": "1.34.0",
		"@sveltejs/adapter-node": "5.5.7",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@types/luxon": "3.7.5",
		"@types/node": "^26.3.0",
		"@vitest/coverage-v8": "4.1.11",
		"clsx": "2.1.1",
		"eslint": "10.9.1",
		"eslint-plugin-svelte": "3.23.0",
		"jsdom": "30.0.1",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"oxlint-tsgolint": "7.0.2001",
		"svelte": "5.56.10",
		"svelte-check": "4.7.6",
		"tailwind-merge": "3.6.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.68.0",
		"vite": "8.2.2",
		"vite-plugin-devtools-json": "1.1.0",
		"vitest": "4.1.11"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "^26",
			"onFail": "download"
		}
	}
}
